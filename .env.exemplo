# Modelo do .env deste painel. Copie para .env e ajuste. Este arquivo é
# VERSIONADO: não escreva senha aqui (tests/test_segredos.py vigia).

# Porta do host em que o container responde. Cada painel da VM tem a sua —
# veja as que já estão em uso com `ssh cenarios-vm 'docker ps'`.
PORTA=8523

# Subcaminho público, o mesmo da rota do nginx: /cenarios/<slug>/.
# Vazio serve na raiz (desenvolvimento local).
BASE_URL_PATH=cenarios/hansedf

# Pack de doença (src/doencas/<nome>.py).
SINAN_DOENCA=hanseniase

# Credenciais do banco, só para os scripts de extração. Preencha no .env,
# nunca aqui.
CENARIOS_HOST=
CENARIOS_USER=
CENARIOS_PASSWORD=
